                    "Library",
                    "Maintenance",
                    "Transport"
                }))
            @Html.ValidationMessageFor(m => m.ServiceType)
        </div>

        <div class="form-group">
            <label>Description</label>
            @Html.TextAreaFor(m => m.Description)
            @Html.ValidationMessageFor(m => m.Description)
        </div>

