<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />

<title>Inventory Management</title>
<style>
body {
font-family: Arial, sans-serif;
margin:30px;
background: #f4f6f9;
}
h2 {color: #243b55;}

table {
border-collapse: collapse;
width: 100%;
background: white;
margin-top: 20px;
}
th, td {
border: 1px solid #ddd;
padding: 12px;
text-align: left;
}
th {
background: #243b55;
color: white;
}
.button {
padding: 8px 12px;
background: #2878b5;
color: white;
text-decoration: none; border:

none;
cursor: pointer;
border-radius: 4px;
}
.delete { background:
#d9534f;
}

.summary {
background: white;
padding: 15px;
margin-top: 20px;
border-left: 5px solid #2878b5;
}
input {
padding:8px;}
</style>
</head>
<body>
<h2>Inventory Management System</h2>
<p>
<a  class="button"  href="@Url.Action("Create",  "Product")">
+ Add New Product
</a>
</p>
<form method="get" action="@Url.Action("Index", "Product")">
<input type="text"
name="search"
value="@ViewBag.Search"
placeholder="Search product name..." />

<button class="button" type="submit">Search</button>
<a class="button" href="@Url.Action("Index", "Product")"> Show All
</a>
</form>
<div class="summary">
<strong>Products displayed:</strong> @Model.Count
<br /><br />
<strong>Total inventory value:</strong>
@(((decimal)ViewBag.TotalInventoryValue).ToString("C"))
</div>
<table>
<thead>
<tr>
<th>Product ID</th>
<th>Product Name</th>
<th>Quantity</th>
<th>Price</th>
<th>Stock Value</th>
<th>Actions</th>
</tr>
</thead>
<tbody>
@foreach (var item in Model)
{
<tr>
<td>@item.ProductId</td>
<td>@item.ProductName</td>
<td>@item.Quantity</td>
<td>@item.Price.ToString("C")</td>
<td>@((item.Quantity * item.Price).ToString("C"))</td>

<td>
<a class="button"
href="@Url.Action("Edit", "Product",
new { id = item.ProductId })"> Edit
</a>
@using (Html.BeginForm("Delete", "Product", new {
id = item.ProductId }, FormMethod.Post))
{
@Html.AntiForgeryToken()
<button class="button delete"
type="submit"
onclick="return confirm('Delete this product?');"> Delete
</button>
}
</td>
</tr>
}
@if (Model.Count == 0)

{
<tr>
<td colspan="6">No products found.</td>
</tr>
}
</tbody>
</table>
</body>
</html>

