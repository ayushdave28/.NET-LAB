@model List<WebApplication13.Models.Product>

@{
    ViewBag.Title = "Index";
    Layout = null;
}

<h2>Product Catalog</h2>

<table border="1">
    <tr>
        <th>Productid</th>
        <th>ProductName</th>
        <th>Description</th>
        <th>Price</th>
        <th>Category</th>
        <th>Action</th>
    </tr>

    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Productid</td>
            <td>@product.ProductName</td>
            <td>@product.Description</td>
            <td>@product.Price</td>
            <td>@product.Category</td>
            <td>
                @Html.ActionLink(
                    "View Details",
                    "Details",
                    "Product",
                    new { id = product.Productid },
                    null
                )
            </td>
        </tr>
    }
</table>    



